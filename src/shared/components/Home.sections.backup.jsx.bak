                      className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-[#041525] font-semibold text-xs sm:text-sm hover:bg-slate-100 hover:shadow-lg transition-all duration-300 group/btn"
                    >
                      View Project
                      <ArrowRight className="w-4 h-4 transition-transform group-hover/btn:translate-x-1" />
                    </a>
                  ) : (
                    <Link
                      to={project.link}
                      className="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-[#041525] font-semibold text-xs sm:text-sm hover:bg-slate-100 hover:shadow-lg transition-all duration-300 group/btn"
                    >
                      View Project
                      <ArrowRight className="w-4 h-4 transition-transform group-hover/btn:translate-x-1" />
                    </Link>
                  )}
                </div>
              </div>

              {/* Card Bottom: Device Mockup Showcase Framed inside the Card */}
              <div className="px-5 sm:px-6 md:px-7 lg:px-8 pb-5 sm:pb-6 pt-1 sm:pt-2">
                <div className="relative rounded-2xl overflow-hidden h-44 sm:h-52 md:h-56 lg:h-60 bg-black/40 border border-white/10 shadow-2xl group-hover:border-white/20 transition-all duration-500">
                  <img
                    src={project.img}
                    alt={project.title}
                    className="w-full h-full object-cover object-top transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                  <div className="absolute inset-0 bg-gradient-to-t from-black/40 via-transparent to-transparent pointer-events-none" />
                </div>
              </div>
            </motion.div>
          ))}
        </div>

        {/* View More Button at the Bottom */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.6, delay: 0.2 }}
          className="flex justify-center mt-7 sm:mt-8 md:mt-10"
        >
          <Link
            to="/our-work"
            className="inline-flex items-center gap-2 px-8 sm:px-10 py-3 sm:py-3.5 rounded-xl bg-[#041525] text-white font-bold text-xs sm:text-sm hover:bg-blue-950 hover:shadow-xl transition-all duration-300 group shadow-md"
          >
            View More
            <ArrowUpRight className="w-4 h-4 transition-transform group-hover:translate-x-1 group-hover:-translate-y-1" />
          </Link>
        </motion.div>

      </div>
    </section>
  );
}

