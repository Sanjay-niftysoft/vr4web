const steps = [
  { id: 1, title: 'Discovery and Planning', desc: 'In-depth consultation to map out requirements, user journeys, and technical architecture.', icon: Search },
  { id: 2, title: 'UI/UX Design', desc: 'Crafting intuitive, human-centric interfaces and interactive prototypes for approval.', icon: PenTool },
