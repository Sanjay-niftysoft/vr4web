const GALLERY = [
  { id: 1, img: '/home-gallery/1.png', span: 'md:col-span-2 md:row-span-2' },
  { id: 2, img: '/home-gallery/2.png', span: 'md:col-span-2' },
  { id: 3, img: '/home-gallery/3.png', span: 'md:col-span-1 lg:col-span-1' },
  { id: 4, img: '/home-gallery/4.png', span: 'md:col-span-1 lg:col-span-1' },
];

function TiltCard({ item, onOpen, index }) {
  const x = useMotionValue(0), y = useMotionValue(0);
  const rx = useSpring(useTransform(y, [-0.5, 0.5], [12, -12]), { stiffness: 200, damping: 20 });
  const ry = useSpring(useTransform(x, [-0.5, 0.5], [-12, 12]), { stiffness: 200, damping: 20 });
  const move = (e) => {
    const r = e.currentTarget.getBoundingClientRect();
    x.set((e.clientX - r.left) / r.width - 0.5);
    y.set((e.clientY - r.top) / r.height - 0.5);
  };
  const reset = () => { x.set(0); y.set(0); };
  return (
    <motion.div
      initial={{ opacity: 0, y: 50 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true, margin: '-40px' }}
      transition={{ duration: 0.7, delay: index * 0.08 }}
      className={`min-h-[220px] [perspective:1000px] ${item.span}`}
    >
      <motion.button
        onPointerMove={move} onPointerLeave={reset} onClick={() => onOpen(index)}
        style={{ rotateX: rx, rotateY: ry, transformStyle: 'preserve-3d' }}
        className="group relative h-full w-full overflow-hidden rounded-[1.5rem] border border-white/10 text-left shadow-[0_30px_60px_-20px_rgba(0,0,0,.8)]"
      >
        <img src={item.img} alt="Gallery item" loading="lazy" className="absolute inset-0 h-full w-full object-cover transition-transform duration-700 group-hover:scale-110" />
      </motion.button>
    </motion.div>
  );
}

export function GallerySection() {
  const [selIndex, setSelIndex] = useState(null);

  const handlePrev = (e) => {
    e.stopPropagation();
    setSelIndex((prev) => (prev === 0 ? GALLERY.length - 1 : prev - 1));
  };
  const handleNext = (e) => {
    e.stopPropagation();
    setSelIndex((prev) => (prev === GALLERY.length - 1 ? 0 : prev + 1));
  };

  return (
    <section className="relative z-10 w-full overflow-hidden bg-[#041525] py-12 md:py-16 font-sans">
      <div className="relative z-10 mx-auto max-w-[1440px] px-4 sm:px-6 md:px-8 lg:px-12 xl:px-16">

        <div className="mb-10 md:mb-14 flex flex-col md:flex-row md:items-end justify-between gap-6">
          <motion.div initial={{ opacity: 0, y: 30 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }} transition={{ duration: 0.8 }} className="max-w-3xl">
            <h2 className="font-sans text-2xl sm:text-3xl md:text-4xl tracking-tight text-white font-bold">
              Our <span className="italic text-[#D37B5C]">Gallery</span>
            </h2>
            <p className="mt-4 text-base text-white/70">A glimpse into our studio and projects.</p>
          </motion.div>

          <motion.div initial={{ opacity: 0, x: 20 }} whileInView={{ opacity: 1, x: 0 }} viewport={{ once: true }} transition={{ duration: 0.8, delay: 0.2 }}>
            <Link to="/gallery" className="group flex items-center justify-center gap-3 overflow-hidden rounded-[1rem] bg-[#0287d0] pl-6 pr-2 py-2 text-sm font-bold text-white shadow-md transition hover:-translate-y-1 hover:shadow-lg active:scale-95 sm:w-auto">
              <span>View All Gallery</span>
              <div className="flex h-8 w-8 items-center justify-center rounded-full bg-white/20 transition-colors group-hover:bg-white text-white group-hover:text-[#0287d0]">
                <ArrowRight className="h-4 w-4" />
              </div>
            </Link>
          </motion.div>
        </div>

        <div className="grid auto-rows-[220px] grid-cols-1 gap-5 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-4 md:auto-rows-[240px] md:gap-6">
          {GALLERY.map((g, i) => <TiltCard key={g.id} item={g} index={i} onOpen={setSelIndex} />)}
        </div>
      </div>

      <AnimatePresence>
        {selIndex !== null && (
          <motion.div initial={{ opacity: 0 }} animate={{ opacity: 1 }} exit={{ opacity: 0 }} onClick={() => setSelIndex(null)}
            className="fixed inset-0 z-[99999] flex items-center justify-center bg-[#07213a]/95 p-6 backdrop-blur-md">

            <button aria-label="Previous" onClick={handlePrev} className="absolute left-4 md:left-10 z-10 grid h-12 w-12 place-items-center rounded-[1rem] bg-white/10 text-white shadow-lg backdrop-blur hover:bg-white hover:text-[#07213a] hover:scale-105 transition-all">
              <ChevronLeft className="h-6 w-6" />
            </button>

            <motion.div key={selIndex} initial={{ opacity: 0, scale: 0.95 }} animate={{ opacity: 1, scale: 1 }} exit={{ opacity: 0, scale: 0.95 }}
              transition={{ type: 'spring', stiffness: 300, damping: 30 }} onClick={(e) => e.stopPropagation()} className="relative w-full max-w-3xl flex justify-center [perspective:1000px]">

              <div className="relative inline-block">
                <img src={GALLERY[selIndex].img} alt="Gallery focus" className="max-h-[70vh] w-auto rounded-[1rem] object-contain shadow-2xl" />
                <button aria-label="Close" onClick={() => setSelIndex(null)} className="absolute -top-4 -right-4 z-20 grid h-10 w-10 place-items-center rounded-full bg-white text-[#07213a] shadow-lg hover:bg-[#fa5a4b] hover:text-white hover:scale-105 transition-all">
                  <X className="h-5 w-5" />
                </button>
              </div>

            </motion.div>

            <button aria-label="Next" onClick={handleNext} className="absolute right-4 md:right-10 z-10 grid h-12 w-12 place-items-center rounded-[1rem] bg-white/10 text-white shadow-lg backdrop-blur hover:bg-white hover:text-[#07213a] hover:scale-105 transition-all">
              <ChevronRight className="h-6 w-6" />
            </button>

          </motion.div>
        )}
      </AnimatePresence>
    </section>
  );
}

