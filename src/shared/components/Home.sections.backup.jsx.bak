function AboutUs() {
  const [activeImg, setActiveImg] = useState(1);

  return (
    <section className="w-full bg-[#FAFAFA] py-8 sm:py-10 md:py-12 lg:py-14 overflow-hidden relative z-10 font-sans">
      {/* Subtle brand background glows */}
      <div className="absolute top-[-5%] left-[-5%] w-[35%] h-[35%] bg-blue-100/50 rounded-full blur-[120px] pointer-events-none" />
      <div className="absolute bottom-[-5%] right-[-5%] w-[35%] h-[35%] bg-orange-100/40 rounded-full blur-[120px] pointer-events-none" />

      <div className="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">

        {/* Centered Top Heading with Brand Accent Line */}
        <motion.div
          initial={{ opacity: 0, y: 20 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.6 }}
          className="flex flex-col items-center text-center mb-8 sm:mb-10"
        >
          <h2 className="text-2xl sm:text-3xl md:text-4xl font-sans font-bold text-[#0f172a] tracking-tight">
            About <span className="italic text-[#D37B5C]">Us</span>
          </h2>
          <div className="w-16 h-1 bg-[#172554] rounded-full mt-3.5" />
        </motion.div>

        {/* Two-Column Layout */}
        <div className="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 xl:gap-16 items-center">

          {/* Left Column (~42% on desktop) */}
          <motion.div
            initial={{ opacity: 0, x: -30 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.8, ease: "easeOut" }}
            className="lg:col-span-5 flex flex-col items-start justify-center"
          >
            {/* Headline */}
            <h3 className="text-xl sm:text-2xl md:text-[28px] font-sans font-bold text-[#0f172a] leading-tight tracking-tight mb-5">
              Empowering Businesses Through <br className="hidden sm:block" />
              <span className="italic text-[#D37B5C]">
                Innovative Technology
              </span>
            </h3>

            {/* Description quote using real company information */}
            <p className="text-black font-medium text-base sm:text-lg leading-relaxed mb-8">
              &ldquo;Born out of a dedication to technology that lasts, VR4WEB connects Australian enterprises to scalable, high-performance digital realities. We believe in transparent partnerships, robust software engineering, and delivering intelligent solutions tailored to accelerate your growth.&rdquo;
            </p>

            {/* Button Actions: Rectangular box shape */}
            <div className="flex flex-wrap items-center gap-4">
              <Link to="/about">
                <button className="group relative flex items-center justify-center gap-2.5 px-6 py-3.5 bg-[#172554] text-white text-xs sm:text-sm font-semibold rounded-md overflow-hidden hover:bg-blue-900 hover:shadow-lg hover:-translate-y-0.5 active:translate-y-0 transition-all duration-300 shadow-md">
                  <span>About Us</span>
                  <ArrowRight className="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1" />
                </button>
              </Link>

              <Link to="/services">
                <button className="flex items-center justify-center gap-2 px-6 py-3.5 bg-white text-[#172554] text-xs sm:text-sm font-semibold rounded-md border border-slate-300 hover:border-[#172554] hover:bg-slate-50 hover:-translate-y-0.5 transition-all duration-300 shadow-sm">
                  <span>Our Services</span>
                </button>
              </Link>
            </div>
          </motion.div>

          {/* Right Column: Interactive 3-Image Composition with hover expansion & box-shadow */}
          <motion.div
            initial={{ opacity: 0, x: 30 }}
            whileInView={{ opacity: 1, x: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.8, ease: "easeOut", delay: 0.2 }}
            className="lg:col-span-7 flex flex-row items-center justify-center gap-2.5 sm:gap-4 md:gap-5 h-[340px] sm:h-[400px] md:h-[440px] lg:h-[470px] pt-4 lg:pt-0"
            onMouseLeave={() => setActiveImg(1)}
          >
            {ABOUT_IMAGES.map((img, idx) => {
              const isActive = activeImg === idx;
              return (
                <div
                  key={img.id}
                  onMouseEnter={() => setActiveImg(idx)}
                  onClick={() => setActiveImg(idx)}
                  className={`group relative overflow-hidden cursor-pointer rounded-2xl sm:rounded-3xl border-2 transition-all duration-500 ease-out min-w-0 ${isActive
                      ? 'flex-[2.2] sm:flex-[2.5] h-full border-[#172554]/30 shadow-[0_25px_60px_rgba(23,37,84,0.35)] z-20 scale-[1.01]'
                      : 'flex-1 h-[84%] sm:h-[88%] border-white/90 shadow-md opacity-80 hover:opacity-100 z-10'
                    }`}
                >
                  <img
                    src={img.url}
                    alt={img.alt}
                    className="w-full h-full object-cover object-center transition-transform duration-700 ease-out group-hover:scale-105"
                    loading="lazy"
                  />
                  {/* Subtle depth gradient overlay */}
                  <div
                    className={`absolute inset-0 bg-gradient-to-t from-[#0f172a]/80 via-transparent to-transparent transition-opacity duration-500 ${isActive ? 'opacity-90' : 'opacity-0 group-hover:opacity-40'
                      }`}
                  />

                  {/* Active Caption Details */}
                  <div
                    className={`absolute bottom-3 sm:bottom-5 left-3 sm:left-5 right-3 sm:right-5 transition-all duration-500 ${isActive ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-4 pointer-events-none'
                      }`}
                  >
                    <span className="inline-block px-2.5 py-0.5 rounded bg-white/20 backdrop-blur-md text-white text-[10px] sm:text-xs font-semibold tracking-wide border border-white/20 mb-1">
                      {img.tag}
                    </span>
                    <p className="text-white text-xs sm:text-sm font-bold truncate drop-shadow-md">
                      {img.title}
                    </p>
                  </div>
                </div>
              );
            })}
          </motion.div>

        </div>
      </div>
    </section>
  );
}

