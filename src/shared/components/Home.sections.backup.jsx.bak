function OurServices() {
  const [currentIndex, setCurrentIndex] = useState(0);
  const [isPaused, setIsPaused] = useState(false);
  const [windowWidth, setWindowWidth] = useState(
    typeof window !== 'undefined' ? window.innerWidth : 1200
  );
  const total = servicesData.length;

  useEffect(() => {
    const handleResize = () => setWindowWidth(window.innerWidth);
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, []);

  const nextSlide = () => {
    setCurrentIndex((prev) => (prev + 1) % total);
  };

  const prevSlide = () => {
    setCurrentIndex((prev) => (prev - 1 + total) % total);
  };

  // Slow, relaxing auto-orbit every 4.0s (1.15s of smooth physical glide, then 2.85s to appreciate each card)
  useEffect(() => {
    if (isPaused) return;
    const timer = setInterval(() => {
      nextSlide();
    }, 4000);
    return () => clearInterval(timer);
  }, [isPaused, currentIndex]);

  // Calculate relative orbital offset from currentIndex
  const getOffset = (idx) => {
    let diff = (idx - currentIndex) % total;
    if (diff > total / 2) diff -= total;
    if (diff < -total / 2) diff += total;
    return diff;
  };

  // Responsive horizontal displacement for the curved cylinder (generous spacing, no overlapping)
  const getOffsets = () => {
    if (windowWidth >= 1280) return { near: '114%', outer: '196%' };
    if (windowWidth >= 1024) return { near: '106%', outer: '180%' };
    if (windowWidth >= 768) return { near: '96%', outer: '165%' };
    return { near: '82%', outer: '145%' };
  };

  const { near, outer } = getOffsets();

  // Compute 3D Cylindrical Perspective according to master prompt hierarchy:
  // FAR (0.58) -> LEFT (0.80) -> ⭐ HERO (1.25) ⭐ <- RIGHT (0.80) <- FAR (0.58)
  const getCardStyle = (diff) => {
    switch (diff) {
      case 0:
        return {
          x: '0%',
          y: -16,
          scale: 1.25,
          rotateY: 0,
          opacity: 1,
          filter: 'none',
          backdropFilter: 'none',
          zIndex: 40,
          visibility: 'visible',
          pointerEvents: 'auto'
        };
      case -1:
        return {
          x: `-${near}`,
          y: 12,
          scale: 0.80,
          rotateY: 13,
          opacity: 0.95,
          filter: 'none',
          backdropFilter: 'none',
          zIndex: 25,
          visibility: 'visible',
          pointerEvents: 'auto'
        };
      case 1:
        return {
          x: near,
          y: 12,
          scale: 0.80,
          rotateY: -13,
          opacity: 0.95,
          filter: 'none',
          backdropFilter: 'none',
          zIndex: 25,
          visibility: 'visible',
          pointerEvents: 'auto'
        };
      case -2:
        return {
          x: `-${outer}`,
          y: 30,
          scale: 0.58,
          rotateY: 25,
          opacity: 0.65,
          filter: 'none',
          backdropFilter: 'none',
          zIndex: 15,
          visibility: 'visible',
          pointerEvents: 'auto'
        };
      case 2:
        return {
          x: outer,
          y: 30,
          scale: 0.58,
          rotateY: -25,
          opacity: 0.65,
          filter: 'none',
          backdropFilter: 'none',
          zIndex: 15,
          visibility: 'visible',
          pointerEvents: 'auto'
        };
      case -3:
        return {
          x: '-220%',
          y: 48,
          scale: 0.40,
          rotateY: 34,
          opacity: 0,
          filter: 'none',
          backdropFilter: 'none',
          zIndex: 0,
          visibility: 'hidden',
          pointerEvents: 'none'
        };
      case 3:
        return {
          x: '220%',
          y: 48,
          scale: 0.40,
          rotateY: -34,
          opacity: 0,
          filter: 'none',
          backdropFilter: 'none',
          zIndex: 0,
          visibility: 'hidden',
          pointerEvents: 'none'
        };
      default:
        return {
          x: diff < 0 ? '-240%' : '240%',
          y: 60,
          scale: 0.35,
          rotateY: 0,
          opacity: 0,
          filter: 'none',
          backdropFilter: 'none',
          zIndex: 0,
          visibility: 'hidden',
          pointerEvents: 'none'
        };
    }
  };

  return (
    <section className="w-full bg-[#F9F7F1] py-8 sm:py-10 md:py-12 relative z-10 font-sans overflow-hidden">
      {/* Ambient background glows */}
      <div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[850px] h-[450px] bg-gradient-to-r from-blue-100/50 via-orange-100/40 to-blue-100/50 rounded-full blur-[110px] pointer-events-none -z-10" />

      <div className="w-full max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12 relative z-10">

        {/* Top Header Section with Controls */}
        <div className="flex flex-col md:flex-row md:items-start justify-between gap-6 sm:gap-8 mb-4 sm:mb-6">
          <motion.div
            initial={{ opacity: 0, y: 20 }}
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.6 }}
            className="max-w-2xl"
          >
            <h2 className="text-2xl sm:text-3xl md:text-4xl font-sans font-bold text-[#0f172a] tracking-tight mb-3 md:mb-4">
              Our <span className="italic text-[#D37B5C]">Services</span>
            </h2>
            <p className="text-black font-medium text-base sm:text-lg leading-relaxed max-w-2xl">
              Whether you need a robust enterprise system or an engaging mobile application, our offerings are designed to maximize and support you on your digital journey.
            </p>
          </motion.div>

          <motion.div
            initial={{ opacity: 0, y: 20 }} 
            whileInView={{ opacity: 1, y: 0 }}
            viewport={{ once: true }}
            transition={{ duration: 0.6, delay: 0.2 }}
            className="flex items-center gap-3 self-start md:self-auto"
          >
            {/* Header Navigation Arrows (Available across all screen sizes) */}
            <div className="flex items-center gap-2">
              <button
                onClick={prevSlide}
                aria-label="Previous service"
                className="w-10 h-10 rounded-xl bg-white border border-slate-200/90 text-[#172554] hover:bg-[#172554] hover:text-white transition-all duration-300 shadow-sm flex items-center justify-center cursor-pointer"
              >
                <ChevronLeft className="w-5 h-5" />
              </button>
              <button
                onClick={nextSlide}
                aria-label="Next service"
                className="w-10 h-10 rounded-xl bg-white border border-slate-200/90 text-[#172554] hover:bg-[#172554] hover:text-white transition-all duration-300 shadow-sm flex items-center justify-center cursor-pointer"
              >
                <ChevronRight className="w-5 h-5" />
              </button>
            </div>

            <Link to="/services">
              <button className="px-5 py-2.5 sm:px-6 sm:py-3 bg-[#172554] text-white text-xs sm:text-sm font-semibold rounded-xl hover:bg-blue-900 hover:shadow-md transition-all duration-300 whitespace-nowrap border border-[#172554]">
                Explore all services
              </button>
            </Link>
          </motion.div>
        </div>

        {/* 3D Curved Cylindrical Carousel Stage */}
        <div
          className="relative w-full py-4 min-h-[580px] sm:min-h-[620px] md:min-h-[650px] flex items-center justify-center"
          onMouseEnter={() => setIsPaused(true)}
          onMouseLeave={() => setIsPaused(false)}
        >
          {/* Curved orbital guide arc behind cards */}
          <div className="absolute inset-0 flex items-center justify-center pointer-events-none -z-10">
            <svg className="w-full max-w-5xl h-[320px] overflow-visible opacity-25 hidden md:block" viewBox="0 0 1000 280" fill="none">
              <ellipse cx="500" cy="140" rx="460" ry="85" stroke="#172554" strokeWidth="1.5" strokeDasharray="6 6" />
              <circle cx="120" cy="165" r="4" fill="#D37B5C" />
              <circle cx="880" cy="165" r="4" fill="#172554" />
            </svg>
          </div>

          {/* Floating Navigation Controls on Extra-Wide Displays (Hidden on standard displays to prevent covering cards) */}
          <button
            onClick={prevSlide}
            aria-label="Previous service"
            className="hidden 2xl:flex absolute -left-12 top-1/2 -translate-y-1/2 z-50 w-12 h-12 rounded-full bg-white text-[#172554] shadow-xl border border-slate-200/90 hover:bg-[#172554] hover:text-white hover:scale-105 active:scale-95 transition-all duration-300 items-center justify-center cursor-pointer"
          >
            <ChevronLeft className="w-6 h-6" />
          </button>

          <button
            onClick={nextSlide}
            aria-label="Next service"
            className="hidden 2xl:flex absolute -right-12 top-1/2 -translate-y-1/2 z-50 w-12 h-12 rounded-full bg-white text-[#172554] shadow-xl border border-slate-200/90 hover:bg-[#172554] hover:text-white hover:scale-105 active:scale-95 transition-all duration-300 items-center justify-center cursor-pointer"
          >
            <ChevronRight className="w-6 h-6" />
          </button>

          {/* 3D Track with 1400px Perspective */}
          <div
            className="relative w-full h-[580px] sm:h-[620px] md:h-[650px] flex items-center justify-center"
            style={{ perspective: 1400, transformStyle: 'preserve-3d' }}
          >
            {servicesData.map((service, index) => {
              const diff = getOffset(index);
              const isCenter = diff === 0;
              const isNear = Math.abs(diff) === 1;
              const Icon = service.icon;
              const style = getCardStyle(diff);

              return (
                <motion.div
                  key={service.id}
                  initial={false}
                  animate={{
                    x: style.x,
                    y: style.y,
                    scale: style.scale,
                    rotateY: style.rotateY,
                    opacity: style.opacity,
                    zIndex: style.zIndex,
                    visibility: style.visibility || 'visible'
                  }}
                  transition={{
                    type: "spring",
                    stiffness: 85,
                    damping: 22,
                    mass: 1.2
                  }}
                  onClick={() => {
                    if (diff !== 0) setCurrentIndex(index);
                  }}
                  className={`group absolute w-[84%] sm:w-[325px] md:w-[345px] lg:w-[365px] h-[440px] sm:h-[455px] rounded-3xl flex flex-col justify-between transition-shadow duration-700 select-none will-change-transform ${
                    isCenter
                      ? 'shadow-[0_40px_80px_-20px_rgba(0,0,0,0.5)] cursor-default ring-1 ring-white/40'
                      : isNear
                      ? 'shadow-[0_20px_40px_rgba(0,0,0,0.3)] cursor-pointer hover:shadow-[0_30px_60px_rgba(0,0,0,0.4)] hover:ring-1 hover:ring-white/20'
                      : 'shadow-[0_10px_20px_rgba(0,0,0,0.2)] cursor-pointer hover:opacity-100'
                  }`}
                  style={{
                    transformStyle: 'preserve-3d',
                    pointerEvents: style.pointerEvents
                  }}
                >
                  {/* Full Background Image Layer (clipped) */}
                  <div 
                    className="absolute inset-0 rounded-3xl overflow-hidden bg-black border border-white/10" 
                    style={{ transform: 'translateZ(0px)' }}
                  >
                    <img
                      src={service.image}
                      alt={service.title}
                      className="w-full h-full object-cover transition-transform duration-1000 ease-out group-hover:scale-105"
                      loading="lazy"
                    />
                    
                    {/* Dark overlay specifically to push side-cards back visually without fading UI content */}
                    <div 
                      className="absolute inset-0 bg-black transition-opacity duration-700 pointer-events-none" 
                      style={{ opacity: isCenter ? 0 : 0.4 }} 
                    />

                    {/* Dark atmospheric overlays for guaranteed text readability without any blue tint */}
                    <div className="absolute inset-0 bg-black/20" />
                    <div className="absolute inset-x-0 bottom-0 h-[85%] bg-gradient-to-t from-black via-black/80 to-transparent pointer-events-none" />
                  </div>

                  {/* Inner glowing border effect for 3D feel */}
                  <div 
                    className="absolute inset-0 border border-white/20 rounded-3xl pointer-events-none" 
                    style={{ transform: 'translateZ(1px)' }} 
                  />

                  {/* Top Floating Badges */}
                  <div 
                    className="relative z-10 flex justify-between items-start p-5 sm:p-6 transition-transform duration-700 ease-out group-hover:[transform:translateZ(40px)]"
                    style={{ transform: 'translateZ(30px)' }}
                  >
                    {/* Floating Service Pill Tag */}
                    <span className="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white text-[#0f172a] text-[10px] sm:text-[11px] font-black uppercase tracking-wider shadow-lg border border-white/60">
                      <span className={`w-1.5 h-1.5 rounded-full ${isCenter ? 'bg-[#D37B5C] animate-pulse' : 'bg-blue-600'}`} />
                      {service.tag}
                    </span>
                    
                    {/* Floating Glassmorphic Icon Badge */}
                    <div
                      className={`w-10 h-10 sm:w-12 sm:h-12 rounded-2xl flex items-center justify-center shadow-2xl transition-all duration-500 ${
                        isCenter
                          ? 'bg-[#172554] text-white ring-2 ring-white/60 scale-110'
                          : 'bg-white text-[#172554] ring-1 ring-black/10'
                      }`}
                    >
                      <Icon className="w-5 h-5 sm:w-6 sm:h-6 stroke-[1.8]" />
                    </div>
                  </div>

                  {/* Bottom Content Body */}
                  <div 
                    className="relative z-10 p-5 sm:p-6 flex flex-col justify-end h-full transition-transform duration-700 ease-out group-hover:[transform:translateZ(50px)]"
                    style={{ transform: 'translateZ(40px)' }}
                  >
                    <div className="mt-auto transform transition-transform duration-500 group-hover:-translate-y-1">
                      {/* Title */}
                      <h3 className="font-sans font-bold text-white text-xl sm:text-2xl leading-snug drop-shadow-md mb-2">
                        {service.title}
                      </h3>

                      {/* Description */}
                      <p className="font-semibold text-xs sm:text-[13px] leading-relaxed text-white line-clamp-2 mb-4 drop-shadow-md">
                        {service.description}
                      </p>

                      {/* Feature Pills */}
                      <div className="flex flex-wrap gap-1.5 mb-4">
                        {service.features.map((feature, fIdx) => (
                          <span
                            key={fIdx}
                            className="px-2.5 py-1 bg-black/50 border border-white/20 text-white text-[10px] sm:text-[11px] font-bold rounded-lg shadow-sm"
                          >
                            {feature}
                          </span>
                        ))}
                      </div>
                    </div>

                    {/* Action CTA Footer */}
                    <div className="pt-4 border-t border-white/20">
                      {isCenter ? (
                        <Link
                          to={service.link}
                          className="w-full inline-flex items-center justify-center gap-2 px-5 py-3 bg-white text-[#172554] text-xs sm:text-sm font-bold rounded-xl hover:bg-[#D37B5C] hover:text-white shadow-[0_10px_20px_rgba(255,255,255,0.3)] transition-all duration-300 group/btn"
                        >
                          <span>Explore Service</span>
                          <ArrowRight className="w-4 h-4 transition-transform duration-300 group-hover/btn:translate-x-1" />
                        </Link>
                      ) : (
                        <div className="w-full flex items-center justify-between px-4 py-2.5 rounded-xl bg-white border border-white/20 text-[#0f172a] group-hover:bg-[#172554] group-hover:text-white text-xs font-bold transition-all duration-300 shadow-[0_4px_15px_rgba(0,0,0,0.3)]">
                          <span>Click to focus</span>
                          <ArrowRight className="w-3.5 h-3.5" />
                        </div>
                      )}
                    </div>
                  </div>
                </motion.div>
              );
            })}
          </div>
        </div>

      </div>
    </section>
  );
}

