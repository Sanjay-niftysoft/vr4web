  { id: 4, title: 'Deployment and Support', desc: 'Smooth product launch followed by ongoing maintenance and scalability upgrades.', icon: Rocket },
];

function OurWorkProcess() {
  const [activeStep, setActiveStep] = useState(null);

  return (
    <section className="w-full bg-[#F9F7F1] py-10 sm:py-12 md:py-14 lg:py-16 relative z-10 font-sans overflow-hidden">
      <div className="max-w-7xl mx-auto px-4 sm:px-6 md:px-8 lg:px-12">
        <motion.div
          initial={{ opacity: 0, y: 30 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true, margin: "-100px" }}
          transition={{ duration: 0.8, ease: "easeOut" }}
          className="mb-8 sm:mb-10 md:mb-12 w-full flex flex-col items-center justify-center text-center"
        >
          <div className="max-w-3xl mx-auto text-center px-2 flex flex-col items-center">
            <div className="inline-flex items-center gap-2 px-3.5 py-1 rounded-full bg-rose-50 border border-rose-200/60 text-rose-600 text-xs sm:text-sm font-bold uppercase tracking-wider mb-3.5 shadow-sm">
              How We Work
            </div>
            <h2 className="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-sans font-bold text-black tracking-tight text-center">
              From Ideas to <span className="italic text-[#D37B5C]">Intelligent Solutions</span>
            </h2>
          </div>
        </motion.div>

        <div className="w-full border-t border-black/15">
          {steps.map((step, index) => {
            const Icon = step.icon;
            const isActive = activeStep === step.id;

            return (
              <motion.div
                key={step.id}
                initial={{ opacity: 0, y: 20 }}
                whileInView={{ opacity: 1, y: 0 }}
                viewport={{ once: true, margin: "-50px" }}
                transition={{ duration: 0.5, delay: index * 0.1 }}
                className="group border-b border-black/15 cursor-pointer relative overflow-hidden select-none"
                onClick={() => setActiveStep(isActive ? null : step.id)}
              >
                {/* Background Hover/Active Effect */}
                <div className={`absolute inset-0 bg-white transition-transform duration-700 ease-in-out -z-10 ${isActive ? 'translate-y-0' : 'translate-y-full lg:group-hover:translate-y-0'}`}></div>

                <div className="flex flex-col py-4 sm:py-5 md:py-6 lg:py-7 px-3 sm:px-4 md:px-8 relative z-10">
                  <div className="flex items-center w-full">
                    <div className="w-12 sm:w-16 md:w-20 lg:w-24 flex-shrink-0">
                      <span className={`text-base sm:text-lg md:text-xl lg:text-2xl font-bold font-sans transition-colors duration-500 ${isActive ? 'text-[#D37B5C]' : 'text-black lg:group-hover:text-[#D37B5C]'}`}>
                        0{step.id}
                      </span>
                    </div>

                    <h3 className={`text-base sm:text-lg md:text-xl lg:text-2xl font-sans font-bold text-black transition-transform duration-500 ease-out flex-1 ${isActive ? 'translate-x-1.5 md:translate-x-3 text-[#D37B5C]' : 'lg:group-hover:translate-x-3'}`}>
                      {step.title}
                    </h3>

                    <div className={`flex-shrink-0 transition-all duration-500 hidden md:block ${isActive ? 'opacity-100 translate-x-0' : 'opacity-0 -translate-x-4 lg:group-hover:opacity-100 lg:group-hover:translate-x-0'}`}>
                      <Icon className="w-7 h-7 md:w-8 md:h-8 lg:w-9 lg:h-9 stroke-[1.5] text-[#D37B5C]" />
                    </div>

                    {/* Mobile indicator chevron */}
                    <div className={`flex-shrink-0 md:hidden transition-transform duration-300 ${isActive ? 'rotate-180 text-[#D37B5C]' : 'text-black'}`}>
                      <svg className="w-5 h-5 sm:w-6 sm:h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path strokeLinecap="round" strokeLinejoin="round" strokeWidth={2.5} d="M19 9l-7 7-7-7" />
                      </svg>
                    </div>
                  </div>

                  {/* Expanding Description */}
                  <div className={`transition-all duration-700 ease-in-out overflow-hidden ${isActive ? 'max-h-[300px] opacity-100' : 'max-h-0 opacity-0 lg:group-hover:max-h-[300px] lg:group-hover:opacity-100'}`}>
                    <div className="pl-12 sm:pl-16 md:pl-20 lg:pl-24 pt-2 md:pt-3 pb-1">
                      <p className={`text-black font-medium text-xs sm:text-sm md:text-base lg:text-lg leading-relaxed max-w-2xl transform transition-transform duration-700 ${isActive ? 'translate-y-0' : '-translate-y-4 lg:group-hover:translate-y-0'}`}>
                        {step.desc}
                      </p>
                    </div>
                  </div>
                </div>
              </motion.div>
            );
          })}
        </div>
      </div>
    </section>
  );
}

