const Styles = () => (
  <style>{`
    @keyframes vr-left{to{transform:translateX(-50%)}}
    @keyframes vr-right{from{transform:translateX(-50%)}to{transform:translateX(0)}}
    .vr-left{animation:vr-left 40s linear infinite}
    .vr-right{animation:vr-right 46s linear infinite}
    .vr-pause:hover .vr-left,.vr-pause:hover .vr-right{animation-play-state:paused}
    @keyframes vr-float{50%{transform:translateY(-16px)}}
    .vr-float{animation:vr-float 6s ease-in-out infinite}
    @media (prefers-reduced-motion:reduce){.vr-left,.vr-right,.vr-float{animation:none}}
  `}</style>
);

/* ============================ CTA ============================ */
export function CallToAction() {
  const mx = useMotionValue(50), my = useMotionValue(40);
  const glow = useMotionTemplate`radial-gradient(520px circle at ${mx}% ${my}%, rgba(211,123,92,.45), transparent 60%)`;
  const move = (e) => {
    const r = e.currentTarget.getBoundingClientRect();
    mx.set(((e.clientX - r.left) / r.width) * 100);
    my.set(((e.clientY - r.top) / r.height) * 100);
  };
  const words = ['Websites', 'Mobile apps', 'E-commerce', 'Software', 'Digital marketing', 'Creative'];

  return (
    <section className="relative z-10 w-full bg-white px-3 py-10 sm:px-6 md:py-16 font-sans">
      <Styles />
      <motion.div
        onPointerMove={move}
        initial={{ opacity: 0, y: 40, scale: 0.98 }}
        whileInView={{ opacity: 1, y: 0, scale: 1 }}
        viewport={{ once: true, margin: '-40px' }}
        transition={{ duration: 0.8, ease: 'easeOut' }}
        className="relative mx-auto overflow-hidden rounded-[2rem] bg-[#07213a] md:rounded-[2rem] max-w-4xl"
      >
        <motion.div style={{ background: glow }} className="pointer-events-none absolute inset-0" />
        <div className="vr-float pointer-events-none absolute -right-24 -top-24 h-80 w-80 rounded-full border border-white/10" />
        <div className="vr-float pointer-events-none absolute -bottom-32 -left-20 h-96 w-96 rounded-full border border-white/10 [animation-delay:2s]" />

        {/* headline */}
        <div className="relative mx-auto w-full px-6 py-12 text-center md:py-14 md:px-12">
          <motion.h2
            initial={{ opacity: 0, y: 40 }} whileInView={{ opacity: 1, y: 0 }} viewport={{ once: true }}
            transition={{ duration: 0.8, delay: 0.2 }}
            className="font-sans text-2xl sm:text-3xl md:text-4xl font-bold leading-tight tracking-tight text-white"
          >
            Let's build <br className="hidden sm:block" />
            something <span className="italic text-[#D37B5C]">great</span> together.
          </motion.h2>
          <p className="mx-auto mt-4 max-w-xl text-xs sm:text-sm md:text-base text-blue-100/90">
            Have a project in mind? Tell us what you need and we'll reply with a clear plan within 2 business hours.
          </p>
          <div className="mt-8 flex flex-col items-stretch justify-center gap-4 sm:flex-row sm:items-center">
            <Link to="/contact">
              <button className="group relative flex w-full items-center justify-center gap-2 overflow-hidden rounded-xl bg-[#fa5a4b] px-6 py-3 text-xs sm:text-sm font-semibold text-white shadow-[0_8px_30px_rgba(250,90,75,.4)] transition hover:-translate-y-1 active:scale-95 sm:w-auto">
                <span className="absolute inset-0 -translate-x-[150%] skew-x-12 bg-gradient-to-r from-transparent via-white/40 to-transparent transition-transform duration-1000 group-hover:translate-x-[150%]" />
                <span className="relative">Get a Quote</span>
                <ArrowRight className="relative h-5 w-5 transition-transform group-hover:translate-x-1" />
              </button>
            </Link>
            <Link to="/contact">
              <button className="flex w-full items-center justify-center gap-2 rounded-xl border border-white/25 px-6 py-3 text-xs sm:text-sm font-semibold text-white transition hover:bg-white hover:text-[#07213a] active:scale-95 sm:w-auto">
                <MessageSquare className="h-5 w-5" /> Contact Us
              </button>
            </Link>
          </div>
        </div>
      </motion.div>
    </section>
  );
}

/* ============================ FAQ ============================ */
const faqs = [
  {
    q: 'What software solutions does VR4WEB engineer?',
    a: 'We engineer end-to-end digital solutions: custom enterprise software, cloud-native web applications, high-performance mobile apps (iOS, Android, Flutter), bespoke SaaS platforms, and intelligent automated workflows tailored to accelerate business growth.'
  },
  {
    q: 'Do you build custom software tailored from scratch?',
    a: 'Yes. Every solution is custom-architected around your unique business workflows, compliance mandates, and long-term scalability requirements. We build modular, battle-tested codebases designed to adapt as your company scales.'
  },
  {
    q: 'How does your agile development process work?',
    a: 'Our methodology runs across four proven phases: 1) Discovery & Architecture Planning, 2) Human-Centric UI/UX Design & Prototyping, 3) Agile Code Sprints with Rigorous QA Testing, and 4) Zero-Downtime Deployment backed by ongoing maintenance.'
  },
  {
    q: 'Who owns the source code and intellectual property?',
    a: 'You own 100% of the code, intellectual property, repositories, design assets, and deployment environments. We execute complete commercial IP transfers upon sprint milestone delivery.'
  },
  {
    q: 'Do you provide ongoing support, hosting and maintenance?',
    a: 'Yes. We offer comprehensive post-launch SLA packages including 24/7 infrastructure monitoring, automated security patching, performance optimization, and regular feature updates to ensure seamless uptime.'
  },
  {
    q: 'How quickly can we start and receive a project quote?',
    a: 'You can request a consultation right now. Our senior technical architects review your requirements and provide an itemized roadmap and sprint estimation within 2 business hours.'
  },
];

